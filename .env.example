# TestFlow Agent — environment overrides
#
# Copy to `.env` and fill in real values to override the defaults that
# generated Playwright specs embed from a discovery capture. All are OPTIONAL:
# generated artifacts run as-is with their captured defaults — these only
# matter when replaying against a live server whose session/credentials have
# changed. Do NOT commit your real `.env` (it is gitignored).

# Target application base URL
BASE_URL=https://opensource-demo.orangehrmlive.com

# Login credentials for the target application
USERNAME=Admin
PASSWORD=admin123

# Session-bound CSRF token. Usually short-lived — the generated assets prefer
# to re-fetch a fresh token at runtime, but this can be set as a fallback.
CSRF_TOKEN=
